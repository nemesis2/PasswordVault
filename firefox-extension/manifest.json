{
  "manifest_version": 2,
  "name": "Vault Autofill Companion",
  "version": "1.1.3",
  "description": "Unlock your self-hosted encrypted vault and autofill logins. All decryption happens locally in the browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vault-autofill@local",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "idle",
    "clipboardWrite",
    "<all_urls>"
  ],
  "background": {
    "persistent": true,
    "scripts": ["crypto-ciphers.js", "crypto-vault.js", "webauthn.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content_passkey_bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["passkey-inpage.js"],
  "browser_action": {
    "default_title": "Vault Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48-mono.png",
      "96": "icons/icon-96-mono.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
}
